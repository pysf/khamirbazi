---
layout: layout.njk
section: basics
pagination:
  data: site.langs
  size: 1
  alias: lang
permalink: "/{{ lang }}/basics/index.html"
eleventyComputed:
  title: "{{ i18n[lang].basics.title }}"
---
{% set t = i18n[lang] %}
<div class="quiet">
  <h1>{{ t.basics.title }}</h1>
  {{ docs[lang].basics | md(lang) | safe }}

  {# The comparison is generated from recipes.json so the numbers cannot drift. #}
  <h2>{{ t.basics.compare }}</h2>
  <p class="muted small">{{ t.basics.compare_note }}</p>
  <dl class="cmp">
    {% for id, st in recipes.styles %}{% set tb = tables[id] %}
    <div>
      <dt><a href="{{ ('/' + lang + '/styles/' + id + '/') | url }}">{{ t.styles[id].name }}</a>{% if lang == "fa" %} <bdi class="latin" dir="ltr">({{ t.styles[id].latin }})</bdi>{% endif %}</dt>
      <dd>
        <span>{{ t.styles[id].blurb }}</span>
        <span class="muted">{{ t.style.hydration }}: {{ st.dough.hydration.value | num(lang) }}{{ t.unit.pct }} · {{ t.style.bake }}: {{ t.style.bake_value | fill({ temp: st.bake.temp_c.value, from: st.bake.time_min.range[0], to: st.bake.time_min.range[1] }, lang) }} · {{ t.style.ferment }}: {% if tb.methodIds.length > 1 %}{{ t.style.ferment_range | fill({ from: t.methods_short[tb.methodIds | first], to: t.methods_short[tb.methodIds | last] }, lang) }}{% else %}{{ t.methods_short[tb.methodIds | first] }}{% endif %}</span>
      </dd>
    </div>
    {% endfor %}
  </dl>

  {{ docs[lang].glossary | md(lang) | safe }}
</div>
