---
layout: layout.njk
section: calc
sumbar: true
pagination:
  data: site.langs
  size: 1
  alias: lang
permalink: "/{{ lang }}/calculator/index.html"
eleventyComputed:
  title: "{{ i18n[lang].calc.title }}"
---
{% set t = i18n[lang] %}
{% macro stepper(id, label, value, step) %}
<div class="field"><label class="lbl" for="{{ id }}">{{ label }}</label>
  <div class="stepper"><button type="button" data-step="-{{ step }}" data-for="{{ id }}" aria-label="{{ t.calc.dec }}">−</button><input id="{{ id }}" type="text" inputmode="decimal" value="{{ value }}" data-min="1"><button type="button" data-step="{{ step }}" data-for="{{ id }}" aria-label="{{ t.calc.inc }}">+</button></div>
  <p class="msg-err" role="alert" hidden></p>
</div>
{% endmacro %}
<div class="stack">
  <h1>{{ t.calc.title }}</h1>
  <p class="lead">{{ t.calc.intro }}</p>
  <noscript><p class="msg-err">{{ t.calc.noscript }}</p></noscript>
</div>

<div class="calc">
  <form class="card form" id="calc-form" aria-label="{{ t.calc.title }}" autocomplete="off" novalidate>
    <div class="field"><label class="lbl" for="f-style">{{ t.calc.style }}</label>
      <select id="f-style" class="inp">{% for sid, st in recipes.styles %}<option value="{{ sid }}">{{ t.styles[sid].name }}</option>{% endfor %}</select></div>
    <div class="field"><label class="lbl" for="f-method">{{ t.calc.method }}</label>
      <select id="f-method" class="inp">{% for mid, m in recipes.methods %}<option value="{{ mid }}">{{ t.methods[mid] }}</option>{% endfor %}</select></div>
    <div class="field"><span class="lbl" id="l-yeast">{{ t.calc.yeast_type }}</span>
      <div class="seg lg" role="group" aria-labelledby="l-yeast">
        <button type="button" class="seg-b" data-yeast="dry" aria-pressed="true">{{ t.calc.yeast_dry_short }}</button>
        <button type="button" class="seg-b" data-yeast="fresh" aria-pressed="false">{{ t.calc.yeast_fresh_short }}</button>
      </div>
</div>

    <p class="hint" id="mode-hint"></p>

    <div id="ball-inputs" class="row2">
      {{ stepper("f-count", t.calc.pizzas, 2, 1) }}
      {{ stepper("f-ball", t.calc.ball, 250, 10) }}
    </div>

    <div id="pan-inputs" class="field" hidden>
      <span class="lbl">{{ t.calc.pans }}</span>
      <ul class="pans" id="pan-list"></ul>
      <p class="msg-err" id="pan-error" role="alert" hidden></p>
      <span class="hint">{{ t.calc.presets }}</span>
      <div class="chips" id="pan-presets"></div>
      <details class="custom">
        <summary>{{ t.calc.custom_title }}</summary>
        <div class="seg" role="group" aria-label="{{ t.calc.shape }}">
          <button type="button" class="seg-b" data-shape="round" aria-pressed="true">{{ t.calc.shape_round }}</button>
          <button type="button" class="seg-b" data-shape="rect" aria-pressed="false">{{ t.calc.shape_rect }}</button>
        </div>
        <div class="row2">
          <div class="field" data-for-shape="round"><label class="lbl" for="c-diameter">{{ t.calc.diameter }}</label><input id="c-diameter" class="inp" type="text" inputmode="decimal"></div>
          <div class="field" data-for-shape="rect" hidden><label class="lbl" for="c-length">{{ t.calc.length }}</label><input id="c-length" class="inp" type="text" inputmode="decimal"></div>
          <div class="field" data-for-shape="rect" hidden><label class="lbl" for="c-width">{{ t.calc.width }}</label><input id="c-width" class="inp" type="text" inputmode="decimal"></div>
        </div>
        <div class="btn-row"><button type="button" class="btn btn-secondary" id="custom-add">{{ t.calc.custom_add }}</button></div>
      </details>
      <button type="button" class="sw" role="switch" aria-checked="false" id="thick" hidden><span class="trk"></span><span>{{ t.calc.thick }}</span></button>
    </div>

    <div class="field"><label class="lbl" for="f-bake">{{ t.calc.bake_time }}</label>
      <input id="f-bake" class="inp" type="datetime-local">
      <span class="hint">{{ t.calc.bake_time_help }}</span></div>
  </form>

  <div class="results" id="results" tabindex="-1"></div>
</div>

<script type="application/json" id="calc-data">{{ { recipes: recipes, strings: t, lang: lang } | dump | safe }}</script>
<script type="module" src="{{ '/assets/calculator-page.js' | url }}"></script>
