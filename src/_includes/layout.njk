{% set t = i18n[lang] %}{% set other = t.other_lang %}<!doctype html>
<html lang="{{ lang }}" dir="{{ t.dir }}">
<head>
  <meta charset="utf-8">
  <meta name="viewport" content="width=device-width, initial-scale=1">
  <title>{{ title }} - {{ t.site_name }}</title>
  <meta name="description" content="{{ t.tagline }}">
  <meta name="color-scheme" content="light dark">
  <link rel="icon" href="{{ '/assets/favicon.svg' | url }}" type="image/svg+xml">
  <script>
    /* Apply the saved or system theme before the page paints. Works without storage. */
    (function () {
      var d = document.documentElement, theme = null;
      d.classList.add("js");
      try { theme = localStorage.getItem("theme"); } catch (e) {}
      if (theme !== "light" && theme !== "dark") theme = window.matchMedia && matchMedia("(prefers-color-scheme: dark)").matches ? "dark" : "light";
      d.setAttribute("data-theme", theme);
    })();
  </script>
  <link rel="preload" href="{{ ('/assets/fonts/' + ('vazirmatn-arabic-wght-normal.woff2' if lang == 'fa' else 'inter-latin-400-normal.woff2')) | url }}" as="font" type="font/woff2" crossorigin>
  <link rel="stylesheet" href="{{ '/assets/style.css' | url }}">
</head>
<body>
  <a class="skip" href="#main">{{ t.skip }}</a>
  <header class="hdr">
    <div class="wrap hdr-row">
      <a class="brand" href="{{ ('/' + lang + '/') | url }}" aria-label="{{ t.site_name }}">
        {% if lang == "fa" %}<span class="lg fa" aria-hidden="true">خمیربازی<span class="ld"></span></span>{% else %}<span class="lg" aria-hidden="true">Kham<span class="di">ı</span>baz<span class="di">ı</span></span>{% endif %}
      </a>
      <div class="hdr-tools">
        <div class="seg" role="group" aria-label="{{ t.lang_label }}">
          <a class="seg-b" lang="en" hreflang="en" href="{{ (page.url | replace('/' + lang + '/', '/en/', 1)) | url }}"{% if lang == "en" %} aria-current="true"{% endif %}>English</a>
          <a class="seg-b" lang="fa" hreflang="fa" href="{{ (page.url | replace('/' + lang + '/', '/fa/', 1)) | url }}"{% if lang == "fa" %} aria-current="true"{% endif %}>فارسی</a>
        </div>
        <button type="button" class="theme-btn" data-theme-toggle aria-label="{{ t.theme.toggle }}">{% icon "moon", "i-moon" %}{% icon "sun", "i-sun" %}</button>
      </div>
      <nav class="nav" aria-label="{{ t.nav.main }}">
        <a href="{{ ('/' + lang + '/') | url }}"{% if section == "home" %} aria-current="page"{% endif %}>{{ t.nav.home }}</a>
        <a href="{{ ('/' + lang + '/#styles') | url }}"{% if section == "styles" %} aria-current="page"{% endif %}>{{ t.nav.styles }}</a>
        <a href="{{ ('/' + lang + '/calculator/') | url }}"{% if section == "calc" %} aria-current="page"{% endif %}>{{ t.nav.calculator }}</a>
        <a href="{{ ('/' + lang + '/basics/') | url }}"{% if section == "basics" %} aria-current="page"{% endif %}>{{ t.nav.basics }}</a>
      </nav>
    </div>
  </header>
  <main id="main" class="wrap main">
    {{ content | safe }}
  </main>
  {% if sumbar %}{% include "sumbar.njk" %}{% endif %}
  <footer class="ftr"><div class="wrap">{{ t.footer.disclaimer }}</div></footer>
  <script type="module" src="{{ '/assets/site.js' | url }}"></script>
</body>
</html>
