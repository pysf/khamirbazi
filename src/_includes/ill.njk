{# Flat style illustrations from the design. Usage: {% from "ill.njk" import ill %}{{ ill(site.illustrations[id]) }} #}
{% macro ill(i) %}<svg viewBox="0 0 120 100">
{% if i.shape == "round" %}<circle class="i-crust" cx="60" cy="50" r="46"></circle><circle class="i-sauce" cx="60" cy="50" r="{{ i.sauce }}"></circle><circle class="i-cheese" cx="48" cy="40" r="8"></circle><circle class="i-cheese" cx="72" cy="46" r="8"></circle><circle class="i-cheese" cx="56" cy="64" r="9"></circle><circle class="i-leaf" cx="66" cy="60" r="3.5"></circle>
{% elif i.shape == "rect" %}<rect class="i-crust" x="8" y="22" width="104" height="56" rx="8"></rect><rect class="i-sauce" x="15" y="29" width="90" height="42" rx="4"></rect><circle class="i-cheese" cx="34" cy="42" r="7"></circle><circle class="i-cheese" cx="62" cy="56" r="7"></circle><circle class="i-cheese" cx="88" cy="40" r="7"></circle><circle class="i-leaf" cx="76" cy="58" r="3"></circle>
{% elif i.shape == "square" %}<rect class="i-crust" x="22" y="6" width="76" height="88" rx="8"></rect><rect class="i-edge" x="26" y="10" width="68" height="80" rx="5"></rect><rect class="i-sauce" x="34" y="18" width="52" height="64" rx="3"></rect><circle class="i-cheese" cx="50" cy="34" r="7"></circle><circle class="i-cheese" cx="70" cy="56" r="7"></circle><circle class="i-cheese" cx="50" cy="68" r="6"></circle>
{% elif i.shape == "deep" %}<circle class="i-edge" cx="60" cy="50" r="46"></circle><circle class="i-crust" cx="60" cy="50" r="40"></circle><circle class="i-sauce" cx="60" cy="50" r="30"></circle><circle class="i-cheese" cx="50" cy="42" r="7"></circle><circle class="i-cheese" cx="70" cy="50" r="7"></circle><circle class="i-leaf" cx="56" cy="62" r="3.5"></circle>
{% endif %}</svg>{% endmacro %}
