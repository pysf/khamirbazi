---
layout: layout.njk
section: home
script: home.js
pagination:
  data: site.langs
  size: 1
  alias: lang
permalink: "/{{ lang }}/index.html"
eleventyComputed:
  title: "{{ i18n[lang].home.title }}"
---
{% set t = i18n[lang] %}{% set h = t.home %}{% set first = site.uiStyles | first %}
<section class="hero">
  <h1>{{ h.title }}</h1>
  <p>{{ h.sub }}</p>
</section>
<section class="calc" aria-label="{{ h.calc_label }}" id="calc"
  data-min-pizzas="{{ recipes.methods.warm_2h.min_pizzas }}" data-min-g="{{ recipes.yeast.min_weigh_g.value }}">
  <div class="card rows" role="group" aria-label="{{ h.calc_label }}">
    <div class="row"><label class="k" for="f-style">{{ h.style }}</label>
      <span class="selw"><select id="f-style" class="sel">{% for id in site.uiStyles %}<option value="{{ id }}" data-url="{{ ('/' + lang + '/recipe/' + id + '/') | url }}" data-methods="{{ recipes.styles[id].methods_typical | join(' ') }}" data-default="{{ recipes.styles[id].default_method }}">{{ t.styles[id].name }}</option>{% endfor %}</select>{% icon "chev", "chv" %}</span></div>
    <div class="row"><label class="k" for="f-method">{{ h.method }}</label>
      <span class="selw"><select id="f-method" class="sel">{% for m in recipes.styles[first].methods_typical %}<option value="{{ m }}"{% if m == recipes.styles[first].default_method %} selected{% endif %}>{{ t.methods_short[m] }}</option>{% endfor %}</select>{% icon "chev", "chv" %}</span></div>
    <div class="row col"><span class="k" id="l-size">{{ h.size }}</span>
      <div class="segc" role="group" aria-labelledby="l-size" data-group="size">
        {% for s in recipes.sizes %}<button type="button" data-value="{{ s.id }}" aria-pressed="{{ 'true' if s.id == 'round_30' else 'false' }}">{{ s.diameter }}<small>{{ h.cm }}</small></button>{% endfor %}
      </div></div>
    <div class="row"><span class="k" id="l-count">{{ h.count }}</span>
      <div class="stp" role="group" aria-labelledby="l-count"><button type="button" data-step="-1" aria-label="{{ h.dec }}">−</button><span class="val" id="f-count" aria-live="polite">2</span><button type="button" data-step="1" aria-label="{{ h.inc }}">+</button></div></div>
    <div class="row"><span class="k" id="l-yeast">{{ h.yeast }}</span>
      <div class="segc inline" role="group" aria-labelledby="l-yeast" data-group="yeast"><button type="button" data-value="dry" aria-pressed="true">{{ h.dry }}</button><button type="button" data-value="fresh" aria-pressed="false">{{ h.fresh }}</button></div></div>
  </div>
    <p class="row-err" id="count-err" role="alert" hidden>{{ h.err_min_batch | fill({ min: recipes.methods.warm_2h.min_pizzas, min_g: recipes.yeast.min_weigh_g.value }, lang) }}</p>
  <script type="application/json" id="method-labels">{{ t.methods_short | dump | safe }}</script>
  <a class="btn btn-primary btn-lg" id="cta" href="{{ ('/' + lang + '/recipe/' + first + '/') | url }}">{{ h.cta }}</a>
  <a class="lnk-card" href="{{ ('/' + lang + '/basics/') | url }}"><span><strong>{{ h.new_to }}</strong><br><span class="muted">{{ h.new_to_sub }}</span></span>{% icon "arrow", "dir-icon" %}</a>
</section>
